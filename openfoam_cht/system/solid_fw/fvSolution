FoamFile
{
    version 2.0; format ascii; class dictionary; location "system/solid_fw"; object fvSolution;
}
solvers
{
    "(h|T)"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-7;
        relTol          0.1;
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
}
relaxationFactors
{
    equations   { h 0.8; T 0.8; }
}
