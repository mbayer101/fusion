FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0]; // Kelvin

internalField   uniform 300.0;   // Initial temperature: 300 K

boundaryField
{
    walls
    {
        type            fixedValue;
        value           uniform 300.0;
    }
}
