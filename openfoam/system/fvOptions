FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

nuclearHeating
{
    type            scalarSemiImplicitSource;
    active          true;

    scalarSemiImplicitSourceCoeffs
    {
        selectionMode   all;
        volumeMode      specific;

        sources
        {
            T
            {
                // Net volumetric thermal source balanced with LBE convective removal
                explicit    1.0;
                implicit    0.0;
            }
        }
    }
}

lbeConvectiveCooling
{
    type            scalarSemiImplicitSource;
    active          true;

    scalarSemiImplicitSourceCoeffs
    {
        selectionMode   all;
        volumeMode      specific;

        sources
        {
            T
            {
                // Stable convective cooling sink: Su = +0.0723 K/s, Sp = -0.0001 s^-1
                explicit    0.072315;
                implicit   -0.0001;
            }
        }
    }
}
