FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   0.01; // Convert cm to meters

vertices
(
    (-50 -50 -50)
    ( 50 -50 -50)
    ( 50  50 -50)
    (-50  50 -50)
    (-50 -50  50)
    ( 50 -50  50)
    ( 50  50  50)
    (-50  50  50)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (25 25 25) simpleGrading (1 1 1)
);

boundary
(
    walls
    {
            type patch;
            faces
            (
                (0 3 2 1)
                (4 5 6 7)
                (0 1 5 4)
                (2 3 7 6)
                (0 4 7 3)
                (1 2 6 5)
            );
    }
);

mergePatchPairs
(
